{"nodes": [{"id": "design_is_2026_10_14_03_verdict", "label": "Verdict: REFINE (ST96 business cards)", "file_type": "document", "source_file": "DESIGN-IS-2026-10-14/03-verdict.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cards score 20/30 without zeroes and communicate honestly, but are not print-ready: decorative gradients became low-resolution rasters in the PDF and color is not prepared for CMYK \u2014 hence REFINE rather than PASS or REJECT.", "_origin": "semantic"}, {"id": "design_is_2026_10_14_03_verdict_raster_gradient", "label": "Decorative gradients rasterized in PDF (#8 thorough)", "file_type": "concept", "source_file": "DESIGN-IS-2026-10-14/03-verdict.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Move glow and gradient divider to inline-SVG radialGradient/linearGradient (or flat color for the line) so Chrome emits vector; 6 images at 113\u00d7103 px on a 70-mm circle are ~40\u201372 dpi and unsuitable for print.", "_origin": "semantic"}, {"id": "design_is_2026_10_14_03_verdict_cmyk_color", "label": "CMYK color preparation and rich black TAC (#8/#9)", "file_type": "concept", "source_file": "DESIGN-IS-2026-10-14/03-verdict.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PDFs contain only /DeviceRGB; convert to CMYK per printer profile (FOGRA39/ISO Coated v2), set background rich black (e.g. 60/40/40/100) and keep TAC \u2264 300%.", "_origin": "semantic"}, {"id": "design_is_2026_10_14_03_verdict_type_scale", "label": "Unify 7pt and 7.4pt type scale (#3 aesthetic)", "file_type": "concept", "source_file": "DESIGN-IS-2026-10-14/03-verdict.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One size plus baseline alignment to the logo gives a single typographic scale instead of two near-identical sizes competing.", "_origin": "semantic"}, {"id": "design_is_2026_10_14_03_verdict_single_glow", "label": "Keep one glow per card (#7/#10)", "file_type": "concept", "source_file": "DESIGN-IS-2026-10-14/03-verdict.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The per-person accent color is already carried by the divider line, so a second glow is redundant trend decoration.", "_origin": "semantic"}, {"id": "design_is_2026_10_14_03_verdict_role_language", "label": "Role language decision: \u00ab\u0421\u043e\u043e\u0441\u043d\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u00bb vs as-is (#4)", "file_type": "concept", "source_file": "DESIGN-IS-2026-10-14/03-verdict.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Decide whether to use \u00ab\u0421\u043e\u043e\u0441\u043d\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u00bb or keep the brandbook wording rather than leaving the ambiguity unresolved.", "_origin": "semantic"}, {"id": "print_business_cards_cards_src_html", "label": "print/business-cards/cards.src.html", "file_type": "code", "source_file": "DESIGN-IS-2026-10-14/03-verdict.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null, "metadata": {"graphify_reference_stub": true}, "_origin": "semantic"}, {"id": "print_business_cards_build_mjs", "label": "print/business-cards/build.mjs", "file_type": "code", "source_file": "DESIGN-IS-2026-10-14/03-verdict.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null, "metadata": {"graphify_reference_stub": true}, "_origin": "semantic"}], "edges": [{"source": "design_is_2026_10_14_03_verdict", "target": "print_business_cards_cards_src_html", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "sourc